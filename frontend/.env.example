VITE_API_BASE_URL=https://api.agentinder.io/v1
VITE_WS_URL=wss://api.agentinder.io/v1/ws
VITE_USE_MOCK=true
VITE_OAUTH_GOOGLE_CLIENT_ID=
VITE_OAUTH_MICROSOFT_CLIENT_ID=
VITE_OAUTH_GITHUB_CLIENT_ID=

# ── Real-backend migration ────────────────────────────────────────────────
# To test an endpoint against the real FastAPI backend instead of MSW mocks:
#   1) point VITE_API_BASE_URL at the backend, e.g. http://localhost:8000/v1
#   2) flip the matching VITE_MIGRATE_* flag below to "true"
#   3) leave VITE_USE_MOCK=true so un-migrated endpoints stay mocked
# VITE_MIGRATE_ALL=true turns every supported endpoint on at once.
VITE_MIGRATE_ALL=
VITE_MIGRATE_FEED=
VITE_MIGRATE_SWIPE=
VITE_MIGRATE_AGENTS_LIST=
VITE_MIGRATE_AGENT_PROFILE=
VITE_MIGRATE_AGENT_CREATE=
VITE_MIGRATE_AGENT_UPDATE=
VITE_MIGRATE_MATCHES=
VITE_MIGRATE_MESSAGES=
VITE_MIGRATE_DATE_HISTORY=
VITE_MIGRATE_DATE_GET=
VITE_MIGRATE_DATE_SCHEDULE=
VITE_MIGRATE_DATE_END=

# ── Dev login identity (real backend) ─────────────────────────────────────
# A JWT signed with the backend's SUPABASE_JWT_SECRET (sub = seeded principal
# UUID), plus the seeded principal/agent UUIDs. Unset = mock seed identity.
# Do NOT commit a real JWT.
VITE_DEV_JWT=
VITE_DEV_PRINCIPAL_ID=
VITE_DEV_AGENT_ID=
